# Local-development values. docker-compose.yml injects this file via env_file:
# and overrides container-specific values (RAG_BACKEND, PG_CONN_STR, EMBEDDING_BASE_URL).
# The app itself reads only process env vars; locally use: uv run --env-file .env ...

# OpenAI-compatible credentials and endpoints
EMBEDDING_API_KEY=your-embedding-api-key
GENERATOR_API_KEY=your-generator-api-key
EMBEDDING_BASE_URL=http://localhost:11434/v1
GENERATOR_BASE_URL=https://api.openai.com/v1

# Model configuration
EMBEDDING_MODEL=nomic-embed-text-v2-moe:latest
EMBEDDING_DIM=768
GENERATOR_MODEL=gpt-4o-mini
RETRIEVER_TOP_K=5

# Langfuse tracing (opt-in)
LANGFUSE_TRACING_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_SERVICE_NAME=qanunai-backend

# Vector store backend: "pgvector" (default) or "qdrant"
RAG_BACKEND=pgvector

# pgvector / Postgres configuration
PG_CONN_STR=postgresql://postgres:postgres@localhost:5432/postgres
PG_TABLE_NAME=qanunai_documents

# Qdrant configuration (only used when RAG_BACKEND=qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=qanunai_documents
QDRANT_API_KEY=
