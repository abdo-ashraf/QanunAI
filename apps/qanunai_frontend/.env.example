# VITE_API_BASE_URL is optional. When empty (default), the app calls the API
# through the Vite dev proxy configured in vite.config.ts (/api and /health ->
# http://localhost:8000). Set it to the backend origin (e.g.
# https://api.example.com) when the frontend is served from a different origin.
VITE_API_BASE_URL=
