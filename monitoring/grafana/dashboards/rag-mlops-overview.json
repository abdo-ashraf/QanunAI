        "y": 1,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "100 * (sum(rate(rag_http_requests_total{job=\"rag-api\",status_code=~\"5..\"}[5m])) or vector(0)) / clamp_min((sum(rate(rag_http_requests_total{job=\"rag-api\"}[5m])) or vector(0)), 1e-9)",
          "refId": "A",
          "legendFormat": "5xx %",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2
        },
        "overrides": []
